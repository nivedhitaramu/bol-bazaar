# ---- Sarvam AI (https://dashboard.sarvam.ai) ----
SARVAM_API_KEY=

# Optional overrides (defaults shown)
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1   (mayura:v1 is the automatic fallback)
# SARVAM_LLM_MODEL=sarvam-105b

# ---- Supabase (Project Settings -> API Keys) ----
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Legacy anon JWT also works here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Legacy service_role JWT also works here. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Aliases also accepted (use either set):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Public base URL used in share links (optional; auto-detected on Vercel)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
